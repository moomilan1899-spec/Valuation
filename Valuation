<title>Executive Dashboard — รายงานการดำเนินการการประเมิน</title>
<style>
:root{--navy:#0b2f59;--navy2:#184d80;--gold:#caa64b;--bg:#f3f6fa;--card:#fff;--ink:#1a273a;--muted:#6c7889;--line:#dfe6ee;--green:#16885b;--amber:#c78b18;--orange:#dc7f27;--red:#c94949;--gray:#9ba7b6}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--ink);font-family:Tahoma,"Noto Sans Thai",system-ui,sans-serif}
header{background:linear-gradient(115deg,var(--navy),#123f70);color:#fff;border-bottom:4px solid var(--gold)} .head{max-width:1540px;margin:auto;padding:22px 26px;display:flex;justify-content:space-between;align-items:center;gap:20px}
