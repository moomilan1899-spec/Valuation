.rankgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:13px} .rankcard{padding:15px} .ranklist{display:grid;gap:7px} .rankitem{display:grid;grid-template-columns:24px 125px 1fr 60px;gap:8px;align-items:center;font-size:11px} .num{width:22px;height:22px;border-radius:7px;background:#edf3f9;display:grid;place-items:center;font-weight:800;color:var(--navy)}
.tablecard{margin-top:13px;padding:15px} .tablewrap{overflow:auto;max-height:520px;border:1px solid var(--line);border-radius:10px} table{width:100%;border-collapse:collapse;font-size:11px} th{position:sticky;top:0;background:var(--navy);color:#fff;padding:9px;z-index:2} td{padding:8px 9px;border-bottom:1px solid #edf1f5;text-align:right} td:nth-child(1),td:nth-child(2),td:nth-child(3){text-align:left} tr:hover td{background:#f7faff} .pill{display:inline-block;padding:4px 7px;border-radius:999px;font-size:10px;font-weight:800} .high{background:#e0f3ea;color:var(--green)} .mid{background:#fff2d9;color:#96630b} .low{background:#fde6e6;color:var(--red)} .zero{background:#edf0f4;color:#667180}
