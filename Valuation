function ranks(a){return a.map((d,i)=>`<div class="rankitem"><span class="num">${i+1}</span><span>${d.province}</span><div class="bar"><div class="fill" style="width:${clamp(d.parcelPct)}%;background:${color(d.parcelPct)}"></div></div><b style="text-align:right;color:${color(d.parcelPct)}">${pct(d.parcelPct)}</b></div>`).join('')} function renderRanks(a){top10.innerHTML=ranks([...a].sort((x,y)=>y.parcelPct-x.parcelPct).slice(0,10));bottom10.innerHTML=ranks([...a].sort((x,y)=>x.parcelPct-y.parcelPct).slice(0,10))}
function pill(v){let s=st(v);return s==='HIGH'?['high','ดี']:s==='MID'?['mid','เฝ้าระวัง']:s==='ZERO'?['zero','ยังไม่เริ่ม']:['low','เร่งรัด']} function renderTable(a){tbody.innerHTML=a.map(d=>{let p=pill(d.parcelPct);return `<tr><td>${d.no}</td><td>${d.province}</td><td>${regionOf(d.province)}</td><td>${fmt(d.target)}</td><td>${pct(d.checkedPct)}</td><td>${pct(d.fixedPct)}</td><td>${fmt(d.totalUnits)}</td><td>${pct(d.marketPct)}</td><td>${fmt(d.totalParcels)}</td><td>${fmt(d.calcParcels)}</td><td>${pct(d.parcelPct)}</td><td><span class="pill ${p[0]}">${p[1]}</span></td></tr>`}).join('');tableCount.textContent=fmt(a.length)+' จังหวัด'}
function norm(n){return {'กรุงเทพ':'กรุงเทพมหานคร','กรุงเทพฯ':'กรุงเทพมหานคร'}[n]||n} function pathFor(coords,minX,maxX,minY,maxY){const W=500,H=900,p=20,s=Math.min((W-p*2)/(maxX-minX),(H-p*2)/(maxY-minY)),ox=(W-(maxX-minX)*s)/2,oy=(H-(maxY-minY)*s)/2,pt=([x,y])=>[(x-minX)*s+ox,H-((y-minY)*s+oy)],ring=r=>r.map((q,i)=>{let[x,y]=pt(q);return`${i?'L':'M'}${x.toFixed(2)},${y.toFixed(2)}`}).join(' ')+' Z';return typeof coords[0][0][0]==='number'?coords.map(ring).join(' '):coords.map(poly=>poly.map(ring).join(' ')).join(' ')}
async function initMap(){try{let res=await fetch(MAP_URL),geo=await res.json(),pts=[];const dig=o=>Array.isArray(o)&&typeof o[0]==='number'?pts.push(o):Array.isArray(o)&&o.forEach(dig);geo.features.forEach(f=>dig(f.geometry.coordinates));let xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]),b=[Math.min(...xs),Math.max(...xs),Math.min(...ys),Math.max(...ys)];thaiMap.innerHTML='';geo.features.forEach(f=>{let name=norm(f.properties.pro_th),p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d',pathFor(f.geometry.coordinates,...b));p.setAttribute('class','province');p.dataset.province=name;p.addEventListener('mousemove',e=>{let d=DATA.find(x=>norm(x.province)===name);tip.style.display='block';tip.style.left=(e.clientX+12)+'px';tip.style.top=(e.clientY+12)+'px';tip.innerHTML=d?`<b>${d.province}</b><br>${regionOf(d.province)}<br>คำนวณราคา: ${pct(d.parcelPct)}<br>${fmt(d.calcParcels)} / ${fmt(d.totalParcels)} แปลง<br>จัดกลุ่มตลาด: ${pct(d.marketPct)}`:`<b>${name}</b><br>ไม่พบข้อมูล`});p.addEventListener('mouseleave',()=>tip.style.display='none');thaiMap.appendChild(p)});loading.style.display='none';mapReady=true;refreshMap(filtered())}catch(e){loading.innerHTML='ไม่สามารถโหลดแผนที่ได้<br><small>กรุณาเชื่อมต่ออินเทอร์เน็ตแล้วรีเฟรช</small>'}}
function refreshMap(a){if(!mapReady)return;let allow=new Set(a.map(d=>norm(d.province))),look=new Map(DATA.map(d=>[norm(d.province),d]));document.querySelectorAll('.province').forEach(p=>{let d=look.get(norm(p.dataset.province));p.setAttribute('fill',allow.has(norm(p.dataset.province))&&d?color(d.parcelPct):'#d9e0e8')})}
function parseSheet(resp){let raw=resp.table.rows.map(r=>(r.c||[]).map(c=>c?(c.v??c.f??''):'')),out=[],n=v=>{if(v===null||v===undefined||v==='')return 0;let x=Number(String(v).replace(/,/g,'').replace(/%/g,''));return Number.isFinite(x)?x:0};raw.forEach(r=>{let no=n(r[0]),province=String(r[1]||'').trim();if(!no||!province)return;let target=n(r[2]),checked=n(r[3]),fixed=n(r[5]),tu=n(r[8]),gu=n(r[9]),tp=n(r[12]),cp=n(r[13]);out.push({no:Math.round(no),province,target,checked,checkedPct:target?checked/target*100:0,fixed,fixedPct:target?fixed/target*100:0,totalUnits:tu,groupedUnits:gu,marketPct:tu?gu/tu*100:0,totalParcels:tp,calcParcels:cp,parcelPct:tp?cp/tp*100:0})});if(out.length<70)throw Error('พบข้อมูลจังหวัดไม่ครบ');return out}
function setLive(t,x){live.className='live '+(t||'');liveText.textContent=x} function loadLiveData(){setLive('','กำลังอัปเดตจาก Google Sheets...');let old=document.getElementById('gs');if(old)old.remove();let s=document.createElement('script');s.id='gs';s.src=`https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?gid=${SHEET_GID}&tqx=responseHandler:handleGoogleSheetResponse&_=${Date.now()}`;s.onerror=()=>setLive('error','เชื่อมต่อ Google Sheets ไม่สำเร็จ • ใช้ข้อมูลสำรอง');document.head.appendChild(s)} function handleGoogleSheetResponse(resp){try{DATA=parseSheet(resp);syncRegions();setLive('ok','ข้อมูลสด • '+new Date().toLocaleString('th-TH',{dateStyle:'short',timeStyle:'short'}));render()}catch(e){setLive('error','ใช้ข้อมูลสำรอง • '+e.message)}}
function syncRegions(){let cur=region.value,n=[...new Set(DATA.map(d=>regionOf(d.province)))].sort();region.innerHTML='<option value="ALL">ทั้งหมด</option>'+n.map(x=>`<option value="${x}">${x}</option>`).join('');if([...region.options].some(o=>o.value===cur))region.value=cur}
region.addEventListener('change',render);status.addEventListener('change',render);search.addEventListener('input',render);reset.addEventListener('click',()=>{region.value='ALL';status.value='ALL';search.value='';render()});
syncRegions();render();initMap();loadLiveData();
</script></body></html>
